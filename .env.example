# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=mongodb://localhost:27017/intelligent-project

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH='$2b$10$...'  # Generate with: node -e "require('bcrypt').hash('yourpassword', 10).then(console.log)"

# Session
COOKIE_SECRET=your-cookie-secret

# DigitalOcean Spaces
DIGITALOCEAN_SPACE_BUCKET=your-bucket
DIGITALOCEAN_SPACE_REGION=fra1
DIGITALOCEAN_SPACE_ENDPOINT=https://fra1.digitaloceanspaces.com
DIGITALOCEAN_SPACE_HOST=fra1.digitaloceanspaces.com
